{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign launch_date = section.settings.launch_date | strip
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .coming-soon__date {
    display: block;
    margin-top: 2rem;
    font-size: 2rem;
    letter-spacing: 0.1rem;
  }

  .coming-soon__date-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 1.3rem;
    letter-spacing: 0.13rem;
    text-transform: uppercase;
    opacity: 0.75;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .coming-soon__date {
      font-size: 2.4rem;
    }
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="rich-text coming-soon content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--center{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__blocks {{ section.settings.content_alignment }}">
        {%- if section.settings.caption != blank -%}
          <p class="rich-text__caption caption-with-letter-spacing caption-with-letter-spacing--medium">
            {{ section.settings.caption | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="rich-text__heading rte inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rich-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if launch_date != blank -%}
          <p class="coming-soon__date">
            {%- if section.settings.date_label != blank -%}
              <span class="coming-soon__date-label">{{ section.settings.date_label | escape }}</span>
            {%- endif -%}
            <time datetime="{{ launch_date | date: '%Y-%m-%d' }}">
              {{- launch_date | date: section.settings.date_format -}}
            </time>
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="rich-text__buttons">
            <a
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
              class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.coming-soon.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "default": "t:sections.coming-soon.settings.caption.default",
      "label": "t:sections.coming-soon.settings.caption.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.coming-soon.settings.heading.default",
      "label": "t:sections.coming-soon.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.coming-soon.settings.text.default",
      "label": "t:sections.coming-soon.settings.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.coming-soon.settings.date_header.content"
    },
    {
      "type": "text",
      "id": "launch_date",
      "default": "2026-12-15",
      "label": "t:sections.coming-soon.settings.launch_date.label",
      "info": "t:sections.coming-soon.settings.launch_date.info"
    },
    {
      "type": "text",
      "id": "date_label",
      "default": "t:sections.coming-soon.settings.date_label.default",
      "label": "t:sections.coming-soon.settings.date_label.label"
    },
    {
      "type": "select",
      "id": "date_format",
      "options": [
        {
          "value": "%B %-d, %Y",
          "label": "t:sections.coming-soon.settings.date_format.options__1.label"
        },
        {
          "value": "%-d %B %Y",
          "label": "t:sections.coming-soon.settings.date_format.options__2.label"
        },
        {
          "value": "%b %-d, %Y",
          "label": "t:sections.coming-soon.settings.date_format.options__3.label"
        },
        {
          "value": "%m/%d/%Y",
          "label": "t:sections.coming-soon.settings.date_format.options__4.label"
        },
        {
          "value": "%d/%m/%Y",
          "label": "t:sections.coming-soon.settings.date_format.options__5.label"
        }
      ],
      "default": "%B %-d, %Y",
      "label": "t:sections.coming-soon.settings.date_format.label"
    },
    {
      "type": "header",
      "content": "t:sections.coming-soon.settings.button_header.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.coming-soon.settings.button_label.label",
      "info": "t:sections.coming-soon.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.coming-soon.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "t:sections.coming-soon.settings.button_style_secondary.label"
    },
    {
      "type": "header",
      "content": "t:sections.coming-soon.settings.layout_header.content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "t:sections.coming-soon.presets.name"
    }
  ]
}
{% endschema %}
